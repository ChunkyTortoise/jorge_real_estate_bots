# =============================================================================
# Jorge Real Estate AI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Required variables are marked [REQUIRED]. Optional ones are marked [OPTIONAL].
# =============================================================================

# ---- AI / LLM ----

# [REQUIRED] Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model routing (defaults are sensible; override if needed)
CLAUDE_MODEL=claude-sonnet-4-5-20250514
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
CLAUDE_SONNET_MODEL=claude-sonnet-4-5-20250514
CLAUDE_OPUS_MODEL=claude-opus-4-5-20250514
DEFAULT_LLM_PROVIDER=claude

# ---- GoHighLevel CRM ----

# [REQUIRED] GHL API credentials (Settings > Integrations > API)
GHL_API_KEY=your_ghl_api_key_here
GHL_LOCATION_ID=your_ghl_location_id_here

# [CRITICAL] Leave EMPTY in production — if set, all webhooks return 401
# GHL_WEBHOOK_SECRET=

# [OPTIONAL] RSA public key for GHL webhook signature verification
# GHL_WEBHOOK_PUBLIC_KEY=

# ---- Database ----

# [REQUIRED] PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jorge_bots

# [REQUIRED] Redis for conversation state, rate limiting, funnel data
REDIS_URL=redis://localhost:6379/0

# ---- Security ----

# [REQUIRED] API key for admin endpoints (X-Admin-Key header)
ADMIN_API_KEY=your_admin_api_key_here

# [REQUIRED] Secret for dashboard JWT auth tokens
JWT_SECRET=your_jwt_secret_here_change_in_production

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ---- Jorge's Calendar ----

# [REQUIRED] Jorge's GHL user ID (for assignment)
JORGE_USER_ID=your_jorge_user_id_here

# [REQUIRED] Jorge's calendar ID (for appointment availability)
JORGE_CALENDAR_ID=your_jorge_calendar_id_here

# ---- Performance Targets ----

# 5-minute response rule (seconds). Leads contacted within 5 min convert 10x.
LEAD_RESPONSE_TIMEOUT_SECONDS=300
LEAD_ANALYSIS_TIMEOUT_MS=500
CMA_GENERATION_TIMEOUT_SECONDS=90

# ---- Jorge's Business Rules ----

JORGE_MIN_PRICE=200000
JORGE_MAX_PRICE=800000
JORGE_SERVICE_AREAS=Rancho Cucamonga,Ontario,Upland,Fontana,Chino Hills
JORGE_PREFERRED_TIMELINE=60
JORGE_STANDARD_COMMISSION=0.06
JORGE_MINIMUM_COMMISSION=0.04

# ---- Application ----

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
BASE_URL=http://localhost:8001

# ---- Monitoring (Optional) ----

# [OPTIONAL] Error tracking
SENTRY_DSN=your_sentry_dsn_here

# [OPTIONAL] Outbound alert webhook (Slack or similar)
ALERT_WEBHOOK_URL=

# ---- Testing ----

# Set to true to use mock LLM responses (no API calls)
USE_MOCK_LLM=false
TEST_MODE=false

# ---- Buyer Bot (Optional) ----

BUYER_PIPELINE_ID=your_buyer_pipeline_id
BUYER_ALERT_WORKFLOW_ID=your_buyer_alert_workflow_id

# ---- Seller Bot (Optional) ----

SELLER_PIPELINE_ID=your_seller_pipeline_id
